{
  // Cloudflare Workers static-assets deploy. `npm run build` writes the site to dist/,
  // then `npx wrangler deploy` uploads it. The name must match the Cloudflare project name.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
