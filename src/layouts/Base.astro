---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'blog';
}

const {
  title,
  description = 'Unish Khadka is a computer science student and backend developer building APIs, databases and software that holds up after the demo.',
  current,
} = Astro.props;

const pageTitle = title ? `${title} · Unish Khadka` : 'Unish Khadka';
const home = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title="Unish Khadka · Blog" href={`${home}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Instrument+Serif:ital@0;1&family=Geist:wght@300..600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="mark" href={home}>Unish <em>Khadka</em></a>
        <nav aria-label="Sections">
          <ul class="mono">
            <li><a href={`${home}#work`}>Work</a></li>
            <li><a href={`${home}#approach`}>Approach</a></li>
            <li><a href={`${home}#toolkit`}>Toolkit</a></li>
            <li><a href={`${home}blog/`} aria-current={current === 'blog' ? 'page' : undefined}>Blog</a></li>
            <li><a href={`${home}#contact`}>Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer>
      <div class="wrap mono muted">
        <span>© {new Date().getFullYear()} Unish Khadka</span>
        <span>Set in Bricolage Grotesque, Instrument Serif &amp; Geist</span>
      </div>
    </footer>
  </body>
</html>
