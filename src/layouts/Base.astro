---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'blog';
}

const {
  title,
  description = 'Unish Khadka is a backend engineer and CS student at ULM, building services, data models and queue-based job pipelines in Python and Go.',
  current,
} = Astro.props;

const pageTitle = title ? `${title} · Unish Khadka` : 'Unish Khadka';
const home = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title="Unish Khadka · Writing" href={`${home}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400&display=swap" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="mark" href={home}>Unish Khadka</a>
        <nav aria-label="Sections">
          <ul>
            <li><a href={`${home}#work`}>Work</a></li>
            <li><a href={`${home}#about`}>About</a></li>
            <li><a href={`${home}blog/`} aria-current={current === 'blog' ? 'page' : undefined}>Writing</a></li>
            <li><a href={`${home}#contact`}>Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} Unish Khadka</span>
        <span>Monroe, Louisiana</span>
      </div>
    </footer>
  </body>
</html>
