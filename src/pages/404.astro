---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found">
  <section style="border-top: 0">
    <div class="wrap">
      <div class="sec-head">
        <span class="mono muted">404 · not found</span>
        <h1>Nothing <em>here.</em></h1>
      </div>
      <p class="muted" style="max-width: 46ch">This page doesn't exist, or it moved.</p>
      <a class="cta" href={base}>Back to the home page <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
