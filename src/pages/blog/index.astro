---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

const posts = await getPosts();
const base = import.meta.env.BASE_URL;
---
<Base title="Writing" description="Notes from Unish Khadka on backend engineering, Go, databases and the projects behind this portfolio." current="blog">
  <div class="wrap page-head">
    <div class="row">
      <span class="label">Writing</span>
      <div>
        <h1>Notes on building backends.</h1>
        <p>What I build, how it holds up, and what broke along the way.</p>
      </div>
    </div>
  </div>

  <section>
    <div class="wrap row">
      <span class="label">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      {posts.length === 0 ? (
        <p class="empty">Nothing published yet. The first post is on its way.</p>
      ) : (
        <ol class="posts">
          {posts.map((post) => (
            <li>
              <a href={`${base}blog/${post.id}/`}>
                <span class="t">{post.data.title}{post.data.draft && ' (draft)'}</span>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <span class="d">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</Base>
