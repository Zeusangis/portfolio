---
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../lib/posts';

const base = import.meta.env.BASE_URL;
const latest = (await getPosts()).filter((post) => !post.data.draft).slice(0, 3);

// The hero trace: each span is a section of this page. Start and duration are percentages of the bar.
const spans = [
  { href: '#top', name: 'GET /', tag: 'root', depth: 0, s: 0, d: 100, ms: 240 },
  { href: '#work', name: 'projects.list', depth: 1, s: 3, d: 52, ms: 126 },
  { href: '#climatecrop', name: 'climatecrop', tag: 'py', depth: 2, s: 5, d: 19, ms: 46 },
  { href: '#dendrite', name: 'dendrite', tag: 'go', depth: 2, s: 24, d: 13, ms: 31 },
  { href: '#truehire', name: 'truehire', tag: 'py', depth: 2, s: 33, d: 14, ms: 34 },
  { href: '#athletex', name: 'athletex', tag: 'ts', depth: 2, s: 45, d: 10, ms: 24 },
  { href: '#principles', name: 'principles.check', depth: 1, s: 57, d: 13, ms: 31 },
  { href: '#toolkit', name: 'toolkit.resolve', depth: 1, s: 71, d: 11, ms: 26 },
  { href: '#writing', name: 'writing.recent', depth: 1, s: 83, d: 8, ms: 19 },
  { href: '#contact', name: 'contact.open', depth: 1, s: 92, d: 7, ms: 17 },
];

const projects = [
  {
    id: 'climatecrop', name: 'ClimateCrop AI', line: 'Planting decisions for one farm from public climate and crop data.', href: 'https://github.com/Zeusangis/ClimateCrop-AI', lead: true,
    meta: ['TechXpo 2026', 'Team of two', 'Flask · Next.js · Gemini'],
    summary: 'Turns public climate and crop records into planting decisions for one farm. It ranks which of 30 crops fit, finds when to plant, and follows a crop from sowing to harvest.',
    points: [
      'Crop fit is scored by stated rules against a 30-year NASA climate normal, and every result shows its numbers.',
      'AI only writes advice from facts the app supplies. Answers with a chemical dose or an invented number are rejected.',
      'Frost, heat, heavy-rain and dry-spell alerts come from the real forecast.',
    ],
    cap: 'rules first, AI last',
    flow: [['Next.js app', 'Vercel'], 'REST · session cookie', ['Flask API', 'rules · journeys · expert', true], 'sourced data', [['Climate', 'NASA · Open-Meteo'], ['Crops', 'FAO ECOCROP']], 'fact sheet only', ['AI advice', 'Gemini · Pl@ntNet']],
    numbers: [['144', 'tests'], ['30', 'crops scored'], ['7', 'data sources']],
  },
  {
    id: 'dendrite', name: 'Dendrite', line: 'A local-first knowledge graph for Markdown notes.', href: 'https://github.com/Zeusangis/Dendrite',
    meta: ['Local-first knowledge graph', 'Go · SQLite · Next.js'],
    summary: 'A knowledge graph for Markdown notes that runs entirely on your machine. The vault stays the source of truth; Dendrite builds a searchable graph on top of it.',
    points: [
      'Background sync picks up edits made outside the app, serialized with API writes.',
      'Revision checks reject stale saves and deletes with HTTP 409.',
      'Atomic same-directory writes, strict vault paths and symlink rejection.',
    ],
    cap: 'loopback only',
    flow: [['Next.js graph UI', ':3000'], 'REST', ['Go API server', ':8080', true], 'serialized sync', [['Markdown vault', 'source of truth'], ['SQLite', 'derived graph']]],
    numbers: [['6.8k', 'lines of Go'], ['12', 'test files'], ['0', 'cloud services']],
  },
  {
    id: 'truehire', name: 'TrueHire', line: 'Recruiting where AI gathers evidence and people decide.', href: 'https://github.com/Zeusangis/prometheus',
    meta: ['Evidence-first recruiting', 'Flask · Celery · Redis · React'],
    summary: "Pairs job-specific resume analysis with bounded evidence from a candidate's public GitHub. AI supplies evidence for a human decision; it never accepts or rejects anyone on its own.",
    points: [
      'Screening runs on Celery and Redis after every application, with independent, durable retries.',
      'Recruiter auth, CSRF protection and organization-scoped data.',
      'Append-only audit trail of every stage change and retry.',
    ],
    cap: 'async pipeline',
    flow: [['React + TypeScript', 'TanStack Query'], 'REST', ['Flask API', 'auth · orgs · audit', true], 'enqueue', [['PostgreSQL', 'SQLAlchemy'], ['Celery', 'Redis broker']], 'bounded calls', ['Resume + GitHub analysis', 'Gemini · GitHub REST']],
    numbers: [['136', 'backend tests'], ['CI', 'every push'], ['2 s', 'live refresh']],
  },
  {
    id: 'athletex', name: 'AthleteX', line: 'Training load and ACL injury risk for a whole squad.', href: 'https://github.com/Zeusangis/Nexus',
    meta: ['Training load and ACL risk', 'Express · FastAPI · MediaPipe'],
    summary: 'Coaches see a whole squad on one screen and score landing mechanics from a single jump video.',
    points: [
      'Pose detection measures knee flexion, knee valgus and trunk lean.',
      'Role-based access: coaches manage athletes, athletes only see their own data.',
    ],
    cap: '4 services',
    flow: [['Next.js 15 app', ':3001'], 'JWT bearer', ['Express + Prisma', ':8000', true], 'service calls', [['ACL analysis', 'Flask · OpenCV'], ['Assistant', 'FastAPI']]],
    numbers: [['4', 'services'], ['2', 'languages'], ['3', 'joint angles']],
  },
];
---
<Base>
  <div class="wrap hero">
    <div>
      <span class="label">Backend engineer · CS at ULM</span>
      <h1 style="margin-top:14px">Unish Khadka</h1>
      <p class="lede">Backend engineer focused on <strong>services that stay correct when things fail</strong>. I design data models and APIs, move slow work onto queues with retries and backoff, and make the failure cases explicit, from stale writes to provider outages.</p>
    </div>

    <div class="trace" aria-label="This page drawn as a request trace. Each row links to a section.">
      <div class="trace-head"><span><b>GET</b> /unish-khadka</span><span><span class="ok">200 OK</span> · 10 spans · <b>240 ms</b></span></div>
      <div class="trace-body">
        <div class="axis" aria-hidden="true">
          <span>span</span>
          <div class="ticks"><span style="left:0">0</span><span style="left:25%">60</span><span style="left:50%">120</span><span style="left:75%">180</span><span style="left:100%">240</span></div>
          <span style="text-align:right">ms</span>
        </div>
        {spans.map((sp) => (
          <a class="span" href={sp.href} data-depth={sp.depth} style={`--s:${sp.s};--d:${sp.d}`}>
            <span class="name">{sp.name}{sp.tag && <> <i>{sp.tag}</i></>}</span>
            <span class="track"><span class="bar"></span></span>
            <span class="ms">{sp.ms}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="strip">
      <div><dt>Status</dt><dd class="open">Open to internships</dd></div>
      <div><dt>Tests passing</dt><dd>280 across projects</dd></div>
      <div><dt>Writes</dt><dd>Python, Go, TypeScript</dd></div>
      <div><dt>Based in</dt><dd>Monroe, Louisiana</dd></div>
    </dl>
  </div>

  <section id="work" style="border-top:0">
    <div class="wrap">
      <div class="head">
        <span class="label">Work</span>
        <div><h2>Projects</h2></div>
      </div>

      <div class="plist">
        {projects.map((p) => (
          <details class="prow" id={p.id}>
            <summary>
              <span class="p-name">
                <span class="p-title">{p.name}{p.lead && <span class="badge">Latest</span>}</span>
                <span class="p-line">{p.line}</span>
              </span>
              <span class="p-nums">{p.numbers.map(([v, l]) => <span><b>{v}</b> {l}</span>)}</span>
              <span class="p-toggle" aria-hidden="true"></span>
            </summary>
            <div class="p-detail">
              <div>
                <div class="meta">{p.meta.map((m) => <span>{m}</span>)}</div>
                <p>{p.summary}</p>
                <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
                <div class="foot"><a class="link" href={p.href}>Source on GitHub</a></div>
              </div>
              <aside class="anatomy" aria-label={`${p.name} architecture`}>
                <div class="cap"><span>How it fits together</span><span>{p.cap}</span></div>
                <div class="flow">
                  {p.flow.map((step) =>
                    typeof step === 'string' ? <div class="edge">{step}</div>
                    : Array.isArray(step[0]) ? <div class="pair">{(step as [string, string][]).map(([b, sm]) => <div class="node"><b>{b}</b><small>{sm}</small></div>)}</div>
                    : <div class={step[2] ? 'node core' : 'node'}><b>{step[0]}</b><small>{step[1]}</small></div>
                  )}
                </div>
              </aside>
            </div>
          </details>
        ))}
      </div>
      <p class="hint">Click a project for details and its architecture.</p>
    </div>
  </section>

  <section class="band" id="principles">
    <div class="wrap">
      <div class="head">
        <span class="label">How I build</span>
        <div><h2>Past the prototype.</h2><p>Four habits, each with the project where it shows up.</p></div>
      </div>
      <ul class="rules">
        <li><h3>Migrate it, don't drop it.</h3><p>Schema changes go through versioned migrations, and existing data always keeps an owner.</p><code>TrueHire · Alembic migrations</code></li>
        <li><h3>Expect the provider to fail.</h3><p>Slow work runs on a queue, retries with backoff, and reports partial results honestly.</p><code>TrueHire · Celery retries</code></li>
        <li><h3>Refuse the stale write.</h3><p>Revision checks and atomic writes, so two edits never silently overwrite each other.</p><code>Dendrite · HTTP 409</code></li>
        <li><h3>Rules before models.</h3><p>Decisions come from stated rules. AI writes words from checked facts and never makes the call.</p><code>ClimateCrop AI · rule-scored crops</code></li>
      </ul>
    </div>
  </section>

  <section id="toolkit">
    <div class="wrap">
      <div class="head"><span class="label">Toolkit</span><div><h2>What I reach for.</h2></div></div>
      <div class="duo">
        <dl class="kit">
          <div><dt>Languages</dt><dd>Python, Go, TypeScript, JavaScript, C</dd></div>
          <div><dt>Backend</dt><dd>Flask, Django, FastAPI, Express, Celery</dd></div>
          <div><dt>Data</dt><dd>PostgreSQL, SQLite, MySQL, Redis, SQLAlchemy, Prisma</dd></div>
          <div><dt>Shipping</dt><dd>Docker, Linux, GitHub Actions, Cloudflare</dd></div>
        </dl>
        <div>
          <h3>Currently learning</h3>
          <ul class="now">
            <li><strong>Idiomatic Go.</strong> Services on the standard library, goroutines and channels.</li>
            <li><strong>Concurrency.</strong> Locks, races and serialized work, starting with Dendrite's sync loop.</li>
            <li><strong>Distributed systems.</strong> Queues, idempotency, and what happens when a worker dies mid-job.</li>
            <li><strong>Database internals.</strong> Indexes, transactions, and how a row is actually stored.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="writing">
    <div class="wrap">
      <div class="head"><span class="label">Writing</span><div><h2>Notes from the backend.</h2></div></div>
      <div class="row">
        <span></span>
        <div>
          {latest.length === 0 ? (
            <p class="empty">Short write-ups on what I build and what broke along the way. The first post is in progress.</p>
          ) : (
            <>
              <ol class="posts">
                {latest.map((post) => (
                  <li>
                    <a href={`${base}blog/${post.id}/`}>
                      <span class="t">{post.data.title}</span>
                      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                      <span class="d">{post.data.description}</span>
                    </a>
                  </li>
                ))}
              </ol>
              <a class="link more" href={`${base}blog/`}>All writing</a>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap reach">
      <div>
        <span class="label">Contact</span>
        <h2 style="margin-top:12px">Looking for a backend intern?</h2>
        <p>I'm available for backend internships. If you're hiring, or want to talk about databases and queues, I'd like to hear from you.</p>
      </div>
      <ul class="channels">
        <li><a href="https://www.linkedin.com/in/unish-khadka-642206280/">LinkedIn <span>in/unish-khadka ↗</span></a></li>
        <li><a href="https://github.com/Zeusangis">GitHub <span>@Zeusangis ↗</span></a></li>
        <li><a href="https://x.com/unish_khadka">X <span>@unish_khadka ↗</span></a></li>
        <li><a href="https://instagram.com/unish.khadka.14">Instagram <span>@unish.khadka.14 ↗</span></a></li>
      </ul>
    </div>
  </section>
</Base>
